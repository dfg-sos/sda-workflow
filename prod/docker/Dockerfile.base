FROM logru/fishnet-deps:latest AS build
RUN git clone https://gitlab2.informatik.uni-wuerzburg.de/descartes/sos/sda-workflow.git
RUN mkdir -p /sda-workflow/build
WORKDIR /sda-workflow/build
RUN cmake -DCMAKE_BUILD_TYPE=Release -DSDA_TEST=OFF .. 
RUN cmake --build . --config Release -j 8
RUN cmake --install .

# Runtime stage
FROM ghcr.io/osgeo/gdal:ubuntu-small-3.9.3 AS runtime
RUN apt-get update && apt-get install -y cwltool  && apt-get clean
COPY --from=build /usr/local/bin /usr/local/bin
COPY --from=build /usr/local/lib /usr/local/lib
COPY --from=build /sda-workflow/cwl/ /cwl
RUN mkdir -p /data
RUN mkdir -p /working
WORKDIR /data/working